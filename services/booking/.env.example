# Server Configuration
PORT=4003
SERVER_PORT=4003

# MySQL 8 Database (Host port 3307 avoids clashes with local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=booking_db
MYSQL_USER=booking_user
MYSQL_PASSWORD=booking_pass
MYSQL_URL=jdbc:mysql://localhost:3307/booking_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# Redis Configuration (Host port 6380 per AGENTS.md)
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth and JWT RS256 JWKS Verification
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ticksy-auth
JWT_AUDIENCE=ticksy-api

# gRPC Upstreams
CATALOG_GRPC_TARGET=localhost:50052

# Concurrency & Business Limits
HOLD_TTL_SECONDS=600
MAX_SEATS_PER_BOOKING=6
EXPIRY_CHECK_INTERVAL_MS=30000

# Logging
LOG_LEVEL=INFO
