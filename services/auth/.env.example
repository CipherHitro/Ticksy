NODE_ENV=development
PORT=4001

# Local Postgres (matches docker-compose service name "auth-db")
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/auth_db?schema=public"

# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:3000