NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Local Postgres (matches docker-compose service name "auth-db")
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/auth_db?schema=public"

# RSA key paths for RS256 signing. Generate with:
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Identifies the key in the JWKS endpoint. Change this when you rotate keys.
JWT_KEY_ID=ticksy-key-1

# JWT claim values – must match what other services configure as AUTH_JWKS_URL targets
JWT_ISSUER=ticksy-auth
JWT_AUDIENCE=ticksy-api

# Access token TTL in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# CORS – used by the auth service only; other services rely on the gateway
CORS_ORIGIN=http://localhost:5173

# Used in the OIDC discovery document (/.well-known/openid-configuration).
# Set to the externally reachable URL of Auth so .NET services get the right jwks_uri.
# In Docker this should be http://auth-service:4001
AUTH_SERVICE_URL=http://localhost:4001

# ── Optional: seed admin user ──────────────────────────────────────────────
# These are only read by `npm run seed`. Not needed for normal operation.
# SEED_ADMIN_EMAIL=admin@ticksy.local
# SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_ADMIN_NAME=Admin