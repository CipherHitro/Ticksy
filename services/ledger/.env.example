# Server port
PORT=4005
ASPNETCORE_ENVIRONMENT=Development

# KurrentDB (Event Store)
KURRENTDB_CONNECTION=kurrentdb://localhost:2113?tls=false

# Redis (Read models & Checkpoints)
REDIS_CONNECTION=localhost:6381

# Auth and JWT Verification (OIDC discovery + RS256 JWKS)
AUTH_SERVICE_URL=http://localhost:4001
JWT_ISSUER=ticksy-auth
JWT_AUDIENCE=ticksy-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json

# Platform Fees & Payouts
PLATFORM_FEE_BPS=500
MIN_PAYOUT_MINOR=10000

# Logging
LOG_LEVEL=Information
