{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Ports": {
    "Http": "4005"
  },
  "Jwt": {
    "Issuer": "ticksy-auth",
    "Audience": "ticksy-api",
    "AuthServiceUrl": "http://localhost:4001",
    "MetadataAddress": "http://localhost:4001/.well-known/openid-configuration"
  },
  "Ledger": {
    "PlatformFeeBps": 500,
    "MinPayoutMinor": 10000
  }
}
