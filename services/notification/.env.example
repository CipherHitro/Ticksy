APP_NAME=TicksyNotification
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:4006
PORT=4006

LOG_CHANNEL=json
LOG_LEVEL=info

# Database & Cache (No SQL database used; Redis is system of record)
SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# RabbitMQ (php-amqplib direct topology)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
WORKER_PREFETCH=2

# Kafka
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_GROUP_ID=notification-service
KAFKA_TOPICS=auth.events,booking.events,ledger.events,payment.events
MAX_EVENT_AGE_HOURS=72

# Auth & JWT (RS256 via JWKS)
AUTH_JWKS_URL=http://auth-service:4001/.well-known/jwks.json
JWT_ISSUER=ticksy-auth
JWT_AUDIENCE=ticksy-api

# Email Gateway (log or resend)
EMAIL_DRIVER=log
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_MAX_RPS=2
MAIL_FROM_ADDRESS=no-reply@mail.ticksy.local
MAIL_FROM_NAME=Ticksy

# Display & Links
DISPLAY_TIMEZONE=Asia/Kolkata
APP_BASE_URL=http://localhost:3000
