{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ticksy/notification-service",
    "type": "project",
    "description": "Ticksy Notification Microservice",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-rdkafka": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "firebase/php-jwt": "^6.10",
        "laravel/framework": "^11.31",
        "php-amqplib/php-amqplib": "^3.7",
        "promphp/prometheus_client_php": "^2.12"
    },
    "require-dev": {
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys",
                "PKSA-d5tc-s1qs-h781",
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-mdq4-51ck-6kdq"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
